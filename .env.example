# SMTP configuration used by app/api/enquiry/route.ts
# Copy this file to .env.local and fill in real values.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-connect@faarearth.com
SMTP_PASS=your-app-password
ENQUIRY_TO_EMAIL=sales@faarearth.com

# Google Sheets logging — every enquiry / compliance-request form submission is
# appended as a row here, used by lib/googleSheets.ts.
# Setup (no Google Cloud project needed):
#  1. Open the target Google Sheet.
#  2. Extensions -> Apps Script. Paste the doPost() script (see project README /
#     ask Claude for it) and Save.
#  3. Deploy -> New deployment -> type "Web app".
#     Execute as: Me. Who has access: Anyone.
#  4. Click Deploy, authorize it, then copy the "Web app URL" it gives you
#     (ends in /exec) into GOOGLE_SHEETS_WEBHOOK_URL below.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_SHEETS_TAB_NAME=Sheet1

# Blog admin login, used at /blog/8860 to create/update/delete blog posts.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
# Random secret used to sign the admin session cookie — generate your own,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_SESSION_SECRET=change-me-to-a-random-value
