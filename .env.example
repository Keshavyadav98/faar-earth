# SMTP configuration used by app/api/enquiry/route.ts
# Copy this file to .env.local and fill in real values.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-connect@faarearth.com
SMTP_PASS=your-app-password
ENQUIRY_TO_EMAIL=sales@faarearth.com

# Google Sheets logging — every enquiry / compliance-request form submission is
# appended as a row here, used by lib/googleSheets.ts.
# Setup:
#  1. Create a Google Cloud project (or reuse one) and enable the "Google Sheets API".
#  2. Create a Service Account, then create a JSON key for it.
#  3. From that JSON key, copy "client_email" into GOOGLE_SHEETS_CLIENT_EMAIL
#     and "private_key" into GOOGLE_SHEETS_PRIVATE_KEY (keep it on one line with \n for newlines).
#  4. Open the target Google Sheet and "Share" it with the service account's
#     client_email as an Editor.
#  5. GOOGLE_SHEETS_SPREADSHEET_ID is the long id in the sheet's URL:
#     https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=1eqU2-L4XycM-EaDseusvYQ9wmIploDr1rINJMHocON8
GOOGLE_SHEETS_TAB_NAME=Sheet1

# Blog admin login, used at /blog/8860 to create/update/delete blog posts.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
# Random secret used to sign the admin session cookie — generate your own,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
ADMIN_SESSION_SECRET=change-me-to-a-random-value
